{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "DataModelRef": {
      "additionalProperties": false,
      "description": "Reference to a DataModel with name and semantic version (DM-33).",
      "properties": {
        "kind": {
          "description": "Optional resource kind (must be `DataModel` if present) (MF-07).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Referenced DataModel name (DNS-1123 label).",
          "type": "string"
        },
        "version": {
          "allOf": [
            {
              "$ref": "#/definitions/SemVer"
            }
          ],
          "description": "Referenced DataModel semantic version (DM-22, DM-33)."
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "MappingSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`Mapping`][crate::kinds::mapping::Mapping] resource (DM-33..DM-42).",
      "properties": {
        "contextSpaceRef": {
          "description": "Context Space name to which this mapping belongs (PF-09, DM-33).",
          "type": "string"
        },
        "native": {
          "description": "Native Bloblang escape hatch blocks (DM-38).",
          "items": {
            "$ref": "#/definitions/NativeBlock"
          },
          "type": "array"
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/definitions/DataModelRef"
            }
          ],
          "description": "Source data model reference (DM-33)."
        },
        "target": {
          "allOf": [
            {
              "$ref": "#/definitions/DataModelRef"
            }
          ],
          "description": "Target data model reference (DM-33)."
        },
        "tests": {
          "description": "Golden test cases asserting input entity produces expected output entity (DM-39).",
          "items": {
            "$ref": "#/definitions/MappingTest"
          },
          "type": "array"
        },
        "transformation": {
          "description": "Verbatim LinkML-Map TransformationSpecification payload (DM-33)."
        },
        "vocabularyAlignment": {
          "description": "Optional vocabulary alignment reference (DM-42)."
        }
      },
      "required": [
        "contextSpaceRef",
        "source",
        "target",
        "tests",
        "transformation"
      ],
      "type": "object"
    },
    "MappingTest": {
      "additionalProperties": false,
      "description": "Golden test case asserting input entity produces expected output entity (DM-39).",
      "properties": {
        "expected": {
          "description": "Expected output entity payload (JSON object, DM-39)."
        },
        "input": {
          "description": "Sample input entity payload (JSON object, DM-39)."
        },
        "name": {
          "description": "Test case identifier (DNS-1123 label, DM-39).",
          "type": "string"
        }
      },
      "required": [
        "expected",
        "input",
        "name"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "NativeBlock": {
      "additionalProperties": false,
      "description": "Native code escape hatch block for logic LinkML-Map cannot express (DM-38).",
      "properties": {
        "language": {
          "allOf": [
            {
              "$ref": "#/definitions/NativeLanguage"
            }
          ],
          "description": "Native language of the code block (DM-37, DM-38)."
        },
        "source": {
          "description": "Source code of the native processor (non-empty, DM-38).",
          "type": "string"
        },
        "targetSlot": {
          "description": "Target slot identifier to which this native block is attached (`^[A-Za-z_][A-Za-z0-9_]*$`, DM-38).",
          "type": "string"
        }
      },
      "required": [
        "language",
        "source",
        "targetSlot"
      ],
      "type": "object"
    },
    "NativeLanguage": {
      "description": "Supported native transformation language (DM-37, DM-38).",
      "oneOf": [
        {
          "description": "Inline Bento Bloblang processor (DM-37, DM-38).",
          "enum": [
            "bloblang"
          ],
          "type": "string"
        }
      ]
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "SemVer": {
      "description": "Semantic version string conforming to major.minor.patch (DM-22)",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/MappingSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_MappingSpec",
  "type": "object"
}
