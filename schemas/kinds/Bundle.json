{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "BundleItem": {
      "additionalProperties": false,
      "description": "One resource listed in a [`BundleSpec`] index.",
      "properties": {
        "kind": {
          "description": "Manifest kind of the exported resource; must be a kind this crate knows.",
          "type": "string"
        },
        "name": {
          "description": "`metadata.name` of the resource.",
          "type": "string"
        },
        "namespace": {
          "description": "Namespace of the resource, absent for organization-scoped kinds.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Path of the manifest inside the bundle archive.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "path"
      ],
      "type": "object"
    },
    "BundleSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`Bundle`][crate::kinds::Bundle] download index (MF-17, MF-18).\n\nA Bundle is generated on download and never stored in the repository; it travels inside the archive so the import wizard knows what it received and from where.",
      "properties": {
        "exportedAt": {
          "description": "When the bundle was produced.",
          "format": "date-time",
          "type": "string"
        },
        "exportedBy": {
          "description": "Who produced it (a user or ServiceAccount name).",
          "type": "string"
        },
        "items": {
          "description": "The exported resources.",
          "items": {
            "$ref": "#/definitions/BundleItem"
          },
          "type": "array"
        },
        "nativeFiles": {
          "description": "Native files carried next to their envelopes (`bento.yaml`, `*.linkml.yaml`) (MF-17).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "omitted": {
          "default": 0,
          "description": "How many resources the caller was not allowed to read; names are never disclosed (MF-18).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "sourceInstance": {
          "description": "Base URL of the instance it came from, so a re-import can be traced (MF-25).",
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRevision": {
          "description": "Git revision the export was taken at, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        }
      },
      "required": [
        "exportedAt",
        "exportedBy",
        "items",
        "sourceRevision"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/BundleSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_BundleSpec",
  "type": "object"
}
