{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "ContextSourceRegistrationSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a `ContextSourceRegistration` resource (MF-36, SP-09).",
      "properties": {
        "contextSpaceRef": {
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ],
          "description": "The Context Space whose broker learns of the source. The registration is written into this space's tenant and no other (SP-08, SP-09)."
        },
        "endpoint": {
          "description": "A source elsewhere, as the base URL of its NGSI-LD API. Mutually exclusive with `endpointRef`.",
          "type": [
            "string",
            "null"
          ]
        },
        "endpointRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "A source on this platform, as an `Endpoint`. Mutually exclusive with `endpoint`."
        },
        "expiresAt": {
          "description": "When the registration stops being used, if it is not open-ended.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "federation": {
          "allOf": [
            {
              "$ref": "#/definitions/Federation"
            }
          ],
          "default": {
            "identity": "serviceAccount"
          },
          "description": "Who this platform is when it forwards (PF-48)."
        },
        "information": {
          "description": "What the source is claimed to hold, in CIM 009's own `information` shape: this is what the broker matches a query against, so it is the specification's member and not a shape of ours.",
          "items": {
            "$ref": "#/definitions/RegistrationInfo"
          },
          "type": "array"
        },
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/RegistrationMode"
            }
          ],
          "default": "inclusive",
          "description": "How the source's answer relates to the broker's own data."
        },
        "operations": {
          "description": "Which operations the source is registered for, as CIM 009 clause 5.2.9 names them: an operation (`retrieveEntity`) or one of its groups (`federationOps`). Left out means the specification's own default, which is why this is not an enum here: the vocabulary is the broker's and a list of ours would go stale the first time CIM 009 adds a member.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "contextSpaceRef",
        "information"
      ],
      "type": "object"
    },
    "EntitySelector": {
      "additionalProperties": false,
      "description": "Entity type and id/pattern selector within a policy grant (R6).",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/definitions/Urn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit target entity URN."
        },
        "idPattern": {
          "description": "Anchored regular expression matching target entity URNs (R24, R33).",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "Target entity type short name in PascalCase.",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "Federation": {
      "additionalProperties": false,
      "description": "Who this platform is when it forwards to the source (PF-48).",
      "properties": {
        "identity": {
          "allOf": [
            {
              "$ref": "#/definitions/FederationIdentity"
            }
          ],
          "default": "serviceAccount",
          "description": "Which identity the forward carries."
        },
        "serviceAccountRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `ServiceAccount` the hub forwards as, required in `serviceAccount` mode."
        }
      },
      "type": "object"
    },
    "FederationIdentity": {
      "description": "Which identity a forwarded request carries (PF-48).\n\nNeither mode is a grant. `ServiceAccount` reads a source with the grants a `Policy` on that source gave the named account; `Caller` reads it with the caller's own. In both, the hub Endpoint's policy set applies as well and the narrower one wins.",
      "oneOf": [
        {
          "description": "The hub forwards as a `ServiceAccount` of its own, named by `serviceAccountRef`.",
          "enum": [
            "serviceAccount"
          ],
          "type": "string"
        },
        {
          "description": "The caller's own token is forwarded, rewritten for the source's audience.",
          "enum": [
            "caller"
          ],
          "type": "string"
        }
      ]
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "Ref": {
      "anyOf": [
        {
          "description": "Bare string resource name.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TypedRef"
            }
          ],
          "description": "Typed reference with kind, name, and optional namespace."
        }
      ],
      "description": "Reference to another resource, either bare name or typed reference (MF-07)."
    },
    "RegistrationInfo": {
      "additionalProperties": false,
      "description": "Specification of target entity types, properties, and relationships (R6).",
      "properties": {
        "entities": {
          "description": "Target entity selectors.",
          "items": {
            "$ref": "#/definitions/EntitySelector"
          },
          "type": "array"
        },
        "propertyNames": {
          "description": "Whitelist of readable or writable property names (R6, R9).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "relationshipNames": {
          "description": "Whitelist of readable or writable relationship names (R6, R9).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "entities"
      ],
      "type": "object"
    },
    "RegistrationMode": {
      "description": "How the broker treats a source's answer relative to its own data (CIM 009 clause 5.2.9).",
      "oneOf": [
        {
          "description": "The source is one of several answers and the broker merges it with the rest.",
          "enum": [
            "inclusive"
          ],
          "type": "string"
        },
        {
          "description": "The source is the only answer for what it covers.",
          "enum": [
            "exclusive"
          ],
          "type": "string"
        },
        {
          "description": "The source answers alongside the broker's own data without overriding it.",
          "enum": [
            "auxiliary"
          ],
          "type": "string"
        },
        {
          "description": "The caller is redirected to the source rather than the broker forwarding.",
          "enum": [
            "redirect"
          ],
          "type": "string"
        }
      ]
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "Urn": {
      "description": "NGSI-LD entity URN conforming to ADR 001 / PF-42: urn:ngsi-ld:{Type}:{orgDomain}:{space}:{localId}",
      "pattern": "^urn:ngsi-ld:[A-Z][A-Za-z0-9]{1,63}:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+:[a-z0-9][a-z0-9-]{0,62}:[A-Za-z0-9._~-]{1,128}$",
      "type": "string"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/ContextSourceRegistrationSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_ContextSourceRegistrationSpec",
  "type": "object"
}
