{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "DataModelRef": {
      "additionalProperties": false,
      "description": "Reference to a DataModel with name and semantic version (DM-33).",
      "properties": {
        "kind": {
          "description": "Optional resource kind (must be `DataModel` if present) (MF-07).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Referenced DataModel name (DNS-1123 label).",
          "type": "string"
        },
        "version": {
          "description": "Served major version of the referenced model, `\"1\"`, `\"2\"` … (DM-22, DM-33).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ModelProjectionSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a `ModelProjection` resource (MP-01).",
      "properties": {
        "classes": {
          "description": "The exposed classes. A class not listed is not exposed.",
          "items": {
            "$ref": "#/definitions/ProjectedClass"
          },
          "type": "array"
        },
        "contextSpaceRef": {
          "description": "DNS-1123 label of the owning Context Space; with `metadata.namespace` it derives the repository path (MF-06).",
          "type": "string"
        },
        "dataModelRef": {
          "allOf": [
            {
              "$ref": "#/definitions/DataModelRef"
            }
          ],
          "description": "The model this is a subset of: one DataModel of the space at one served major (DM-22)."
        },
        "filter": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectionFilter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional residual filter."
        }
      },
      "required": [
        "classes",
        "contextSpaceRef",
        "dataModelRef"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "ProjectedClass": {
      "additionalProperties": false,
      "description": "One exposed class and the slots it keeps.",
      "properties": {
        "name": {
          "description": "The class (NGSI-LD entity type short name) as the model names it.",
          "type": "string"
        },
        "slots": {
          "default": [],
          "description": "The slots kept. Empty means identity only: `id` and `type`, nothing else.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ProjectionFilter": {
      "additionalProperties": false,
      "description": "A residual filter in NGSI-LD query syntax, intersected like a REWRITE constraint (GW10).",
      "properties": {
        "geoQ": {
          "description": "`geoQ` as one string (`georel`, `geometry`, `coordinates` joined with `;`).",
          "type": [
            "string",
            "null"
          ]
        },
        "q": {
          "description": "`q` (CIM 009 clause 4.9).",
          "type": [
            "string",
            "null"
          ]
        },
        "scopeQ": {
          "description": "`scopeQ` (CIM 009 clause 4.19).",
          "type": [
            "string",
            "null"
          ]
        },
        "temporalQ": {
          "description": "`temporalQ` as one string (`timerel`, `timeAt`, `endTimeAt`, `timeproperty` joined with `;`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/ModelProjectionSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_ModelProjectionSpec",
  "type": "object"
}
