{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "BlueprintSpec": {
      "additionalProperties": false,
      "description": "`spec` of a Blueprint (CC-23…CC-27, CC-59).",
      "properties": {
        "allowedRoles": {
          "description": "Roles that may see and run this blueprint (CC-59, CC-30).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "category": {
          "description": "Gallery grouping, e.g. `alerting` or `onboarding` (CC-30).",
          "type": [
            "string",
            "null"
          ]
        },
        "parameterSchema": {
          "description": "JSON Schema draft-07 of the parameters: the complete user-facing surface (CC-24)."
        },
        "riskClass": {
          "allOf": [
            {
              "$ref": "#/definitions/RiskClass"
            }
          ],
          "description": "The merge lane changes from this blueprint take (CC-59, CC-63)."
        },
        "templates": {
          "description": "The templates this blueprint expands into (CC-23).",
          "items": {
            "$ref": "#/definitions/BlueprintTemplate"
          },
          "type": "array"
        },
        "version": {
          "allOf": [
            {
              "$ref": "#/definitions/SemVer"
            }
          ],
          "description": "Blueprint version; an upgrade never silently rewrites instances (CC-26)."
        }
      },
      "required": [
        "allowedRoles",
        "parameterSchema",
        "riskClass",
        "templates",
        "version"
      ],
      "type": "object"
    },
    "BlueprintTemplate": {
      "additionalProperties": false,
      "description": "One template, rendering exactly one manifest (CC-23).",
      "properties": {
        "name": {
          "description": "Stable name of this template; it names the rendered file and appears in diagnostics.",
          "type": "string"
        },
        "template": {
          "description": "The minijinja (Jinja2) source, rendered in a sandbox with no filesystem, no environment and strict undefined values (ADR-N-005).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "template"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "RiskClass": {
      "description": "The review lane a blueprint's changes take (CC-59, CC-63).",
      "oneOf": [
        {
          "description": "Auto-approved by the policy bot; still committed, attributed and revertible (CC-64).",
          "enum": [
            "green"
          ],
          "type": "string"
        },
        {
          "description": "One domain approver (CC-34).",
          "enum": [
            "yellow"
          ],
          "type": "string"
        },
        {
          "description": "The full approval chain: cross-domain, public exposure, federation, deletion (CC-63).",
          "enum": [
            "red"
          ],
          "type": "string"
        }
      ]
    },
    "SemVer": {
      "description": "Semantic version string conforming to major.minor.patch (DM-22)",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/BlueprintSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_BlueprintSpec",
  "type": "object"
}
