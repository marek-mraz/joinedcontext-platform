{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Compute": {
      "additionalProperties": false,
      "description": "Compute execution specification (PL-33).",
      "properties": {
        "function": {
          "description": "Entry point function name (for wasm).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/ComputeKind"
            }
          ],
          "description": "Engine kind executing compute logic."
        },
        "mappingRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference to a [`Mapping`][crate::kinds::Mapping] resource."
        },
        "module": {
          "description": "Path or package of the compute module (for wasm).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ComputeKind": {
      "description": "Execution technology category for pipeline compute steps (PL-33).",
      "oneOf": [
        {
          "description": "Inline Bento Bloblang processor.",
          "enum": [
            "bloblang"
          ],
          "type": "string"
        },
        {
          "description": "Compiled LinkML-Map mapping processor (PL-29).",
          "enum": [
            "mapping"
          ],
          "type": "string"
        },
        {
          "description": "Sandboxed WebAssembly WASI module (PL-34).",
          "enum": [
            "wasm"
          ],
          "type": "string"
        },
        {
          "description": "Ephemeral containerized job (PL-35).",
          "enum": [
            "container"
          ],
          "type": "string"
        }
      ]
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "description": "Output specification for derived pipeline computations (PL-32).",
      "properties": {
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/OutputMode"
            }
          ],
          "description": "Write mode applied to target context space."
        },
        "type": {
          "description": "Target entity type name produced.",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "type"
      ],
      "type": "object"
    },
    "OutputMode": {
      "description": "Mutation mode for pipeline output writers (PL-32).",
      "oneOf": [
        {
          "description": "Create or replace complete entity.",
          "enum": [
            "upsert"
          ],
          "type": "string"
        },
        {
          "description": "Update or append attributes onto existing entity.",
          "enum": [
            "update-attrs"
          ],
          "type": "string"
        }
      ]
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "PipelineClass": {
      "description": "Operational execution class of a data pipeline (PL-04, PL-05).",
      "oneOf": [
        {
          "description": "Reconciler automatically determines class from cadence or input mode (PL-05, PL-26).",
          "enum": [
            "auto"
          ],
          "type": "string"
        },
        {
          "description": "Continuous process hosted inside project pipeline runner deployment.",
          "enum": [
            "resident"
          ],
          "type": "string"
        },
        {
          "description": "Ephemeral Kubernetes CronJob executed periodically.",
          "enum": [
            "scheduled"
          ],
          "type": "string"
        }
      ]
    },
    "PipelineQuotas": {
      "additionalProperties": false,
      "description": "Resource quotas for a pipeline runner (PL-11).",
      "properties": {
        "cpuMillicores": {
          "description": "CPU allocation in millicores.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maxMemoryMb": {
          "description": "Maximum allowed memory allocation in megabytes.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PipelineSource": {
      "additionalProperties": false,
      "description": "Source specification for derived pipelines (PL-31).",
      "properties": {
        "endpointRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference to source Endpoint for reading context entities."
        },
        "query": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceQuery"
            },
            {
              "type": "null"
            }
          ],
          "description": "Query parameters for pulling entities."
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/definitions/Trigger"
            },
            {
              "type": "null"
            }
          ],
          "description": "Event subscription trigger for resident processing."
        }
      },
      "type": "object"
    },
    "PipelineSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`Pipeline`][crate::kinds::Pipeline] resource (PL-01..PL-28).",
      "properties": {
        "class": {
          "allOf": [
            {
              "$ref": "#/definitions/PipelineClass"
            }
          ],
          "description": "Operational execution class (PL-04, PL-05)."
        },
        "compute": {
          "anyOf": [
            {
              "$ref": "#/definitions/Compute"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional compute execution specification (PL-33)."
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/definitions/Output"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional output entity type and write mode."
        },
        "quotas": {
          "anyOf": [
            {
              "$ref": "#/definitions/PipelineQuotas"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resource quotas allocated to this pipeline runner (PL-11)."
        },
        "schedule": {
          "description": "Standard cron schedule expression for scheduled runs (PL-04, PL-26..PL-28).",
          "type": [
            "string",
            "null"
          ]
        },
        "secretRefs": {
          "description": "Secret references injected into runner environments (PL-14..PL-16).",
          "items": {
            "$ref": "#/definitions/SecretRef"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/definitions/PipelineSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional context source query or subscription trigger for derived pipelines (PL-31)."
        },
        "targetEndpoint": {
          "allOf": [
            {
              "$ref": "#/definitions/Urn"
            }
          ],
          "description": "Target endpoint URN through which writes occur (PF-39, PL-18)."
        }
      },
      "required": [
        "class",
        "targetEndpoint"
      ],
      "type": "object"
    },
    "Ref": {
      "anyOf": [
        {
          "description": "Bare string resource name.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TypedRef"
            }
          ],
          "description": "Typed reference with kind, name, and optional namespace."
        }
      ],
      "description": "Reference to another resource, either bare name or typed reference (MF-07)."
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "Reference to a credential stored in SOPS or OpenBao (PF-36).\n\n`deny_unknown_fields` is a security control: it rejects inline `value:` or `password:` fields at parse time, enforcing that secrets never appear in Git or manifest files.",
      "properties": {
        "envVar": {
          "description": "Optional environment variable name for injection into runners.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "Optional key within secret.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Secret name in secret store.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "SourceQuery": {
      "additionalProperties": false,
      "description": "NGSI-LD query parameters for pipeline source entity retrieval.",
      "properties": {
        "attrs": {
          "description": "Attributes projection list.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "geoQ": {
          "description": "Geographic query filter string.",
          "type": [
            "string",
            "null"
          ]
        },
        "q": {
          "description": "Entity query filter string.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopeQ": {
          "description": "Scope query filter string.",
          "type": [
            "string",
            "null"
          ]
        },
        "temporalQ": {
          "anyOf": [
            {
              "$ref": "#/definitions/TemporalWindow"
            },
            {
              "type": "null"
            }
          ],
          "description": "Temporal window constraint."
        },
        "type": {
          "description": "Target entity type short name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "SubscriptionTrigger": {
      "additionalProperties": false,
      "description": "Subscription configuration triggering pipeline execution.",
      "properties": {
        "type": {
          "description": "Target entity type name.",
          "type": "string"
        },
        "watchedAttributes": {
          "description": "Whitelist of watched attribute names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "TemporalWindow": {
      "additionalProperties": false,
      "description": "ISO 8601 temporal window for source queries.",
      "properties": {
        "window": {
          "description": "ISO 8601 duration string (e.g. `P1D`).",
          "type": "string"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": false,
      "description": "Subscription trigger for resident pipelines (PL-31).",
      "properties": {
        "subscription": {
          "allOf": [
            {
              "$ref": "#/definitions/SubscriptionTrigger"
            }
          ],
          "description": "Underlying context subscription details."
        }
      },
      "required": [
        "subscription"
      ],
      "type": "object"
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "Urn": {
      "description": "NGSI-LD entity URN conforming to ADR 001 / PF-42: urn:ngsi-ld:{Type}:{orgDomain}:{space}:{localId}",
      "pattern": "^urn:ngsi-ld:[A-Z][A-Za-z0-9]{1,63}:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+:[a-z0-9][a-z0-9-]{0,62}:[A-Za-z0-9._~-]{1,128}$",
      "type": "string"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/PipelineSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_PipelineSpec",
  "type": "object"
}
