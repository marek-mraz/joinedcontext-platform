{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "DataModelLifecycle": {
      "description": "Lifecycle state of a DataModel version (DM-26, DM-48).",
      "oneOf": [
        {
          "description": "Draft data model under active development (DM-26).",
          "enum": [
            "draft"
          ],
          "type": "string"
        },
        {
          "description": "Published immutable data model version (DM-22, DM-26).",
          "enum": [
            "published"
          ],
          "type": "string"
        },
        {
          "description": "Deprecated data model version superseded by a newer release (DM-26).",
          "enum": [
            "deprecated"
          ],
          "type": "string"
        },
        {
          "description": "Retired data model version accepting no new references (DM-26).",
          "enum": [
            "retired"
          ],
          "type": "string"
        },
        {
          "description": "Read-only mirror of a foreign data model (DM-48, DM-49).",
          "enum": [
            "mirrored"
          ],
          "type": "string"
        }
      ]
    },
    "DataModelSource": {
      "description": "Source provenance and authoring origin of a LinkML data model (DM-01, DM-08, DM-48).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Locally authored LinkML data model (DM-01).",
          "properties": {
            "kind": {
              "enum": [
                "authored"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Imported data model from upstream repository (DM-08).",
          "properties": {
            "commit": {
              "description": "Pinned Git commit SHA (7 to 40 lowercase hexadecimal characters).",
              "type": "string"
            },
            "kind": {
              "enum": [
                "imported"
              ],
              "type": "string"
            },
            "path": {
              "description": "Relative path inside the upstream repository.",
              "type": "string"
            },
            "repository": {
              "description": "Git repository URL of upstream data model.",
              "type": "string"
            }
          },
          "required": [
            "commit",
            "kind",
            "path",
            "repository"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Mirrored foreign data model from remote endpoint (DM-48).",
          "properties": {
            "fetched_at": {
              "description": "UTC timestamp when the remote model was fetched.",
              "format": "date-time",
              "type": "string"
            },
            "kind": {
              "enum": [
                "remote"
              ],
              "type": "string"
            },
            "sha256": {
              "description": "SHA-256 digest of the fetched schema (64 lowercase hexadecimal characters).",
              "type": "string"
            },
            "url": {
              "description": "Remote endpoint URL from which the model was fetched.",
              "type": "string"
            },
            "version": {
              "allOf": [
                {
                  "$ref": "#/definitions/SemVer"
                }
              ],
              "description": "Semantic version of the remote model."
            }
          },
          "required": [
            "fetched_at",
            "kind",
            "sha256",
            "url",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "DataModelSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`DataModel`] resource (DM-01..DM-53).",
      "properties": {
        "consumers": {
          "description": "Informational list of platform resources consuming this model version (DM-25).",
          "items": {
            "$ref": "#/definitions/TypedRef"
          },
          "type": "array"
        },
        "contextSpaceRef": {
          "description": "DNS-1123 label of the owning ContextSpace.",
          "type": "string"
        },
        "generated": {
          "allOf": [
            {
              "$ref": "#/definitions/GeneratedArtifacts"
            }
          ],
          "default": {},
          "description": "Generated and committed schema artifacts (DM-02)."
        },
        "lifecycle": {
          "allOf": [
            {
              "$ref": "#/definitions/DataModelLifecycle"
            }
          ],
          "description": "Lifecycle state of this data model version (DM-26)."
        },
        "linkmlPath": {
          "description": "Repository-relative path to the authoritative LinkML source file (DM-01).",
          "type": "string"
        },
        "openWorld": {
          "default": false,
          "description": "Whether entities of this model may contain undeclared attributes (DM-28).",
          "type": "boolean"
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/definitions/DataModelSource"
            }
          ],
          "description": "Source provenance and authoring origin of the model (DM-01, DM-08, DM-48)."
        },
        "version": {
          "allOf": [
            {
              "$ref": "#/definitions/SemVer"
            }
          ],
          "description": "Semantic version of the data model (DM-22)."
        }
      },
      "required": [
        "contextSpaceRef",
        "lifecycle",
        "linkmlPath",
        "source",
        "version"
      ],
      "type": "object"
    },
    "GeneratedArtifacts": {
      "additionalProperties": false,
      "description": "Committed generated artifacts accompanying the LinkML source (DM-02).",
      "properties": {
        "context": {
          "description": "Relative path to compiled JSON-LD @context (DM-02).",
          "type": [
            "string",
            "null"
          ]
        },
        "docs": {
          "description": "Relative path to generated model documentation (DM-02).",
          "type": [
            "string",
            "null"
          ]
        },
        "example": {
          "description": "Relative path to validated example entity (DM-02, DM-21).",
          "type": [
            "string",
            "null"
          ]
        },
        "jsonSchema": {
          "description": "Relative path to compiled JSON Schema draft-07 (DM-02, DM-03).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "SemVer": {
      "description": "Semantic version string conforming to major.minor.patch (DM-22)",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/DataModelSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_DataModelSpec",
  "type": "object"
}
