{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "DataModelLifecycle": {
      "description": "Lifecycle state of a DataModel version (DM-26, DM-48).",
      "oneOf": [
        {
          "description": "Draft data model under active development (DM-26).",
          "enum": [
            "draft"
          ],
          "type": "string"
        },
        {
          "description": "Published immutable data model version (DM-22, DM-26).",
          "enum": [
            "published"
          ],
          "type": "string"
        },
        {
          "description": "Deprecated data model version superseded by a newer release (DM-26).",
          "enum": [
            "deprecated"
          ],
          "type": "string"
        },
        {
          "description": "Retired data model version accepting no new references (DM-26).",
          "enum": [
            "retired"
          ],
          "type": "string"
        },
        {
          "description": "Read-only mirror of a foreign data model (DM-48, DM-49).",
          "enum": [
            "mirrored"
          ],
          "type": "string"
        }
      ]
    },
    "DataModelSource": {
      "additionalProperties": false,
      "description": "Provenance of a data model, absent for a hand-authored one (DM-08, DM-48).\n\nEither the upstream `repository`/`path`/`commit` triple of an imported model or the `remote` block of a mirrored foreign model — never both.",
      "properties": {
        "commit": {
          "description": "Pinned upstream commit, 7 to 40 lowercase hexadecimal characters (DM-08).",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Path inside the upstream repository (DM-08).",
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "anyOf": [
            {
              "$ref": "#/definitions/RemoteSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "Remote endpoint a foreign model was mirrored from (DM-48)."
        },
        "repository": {
          "description": "Upstream repository the model was imported from (DM-08).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DataModelSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`DataModel`][crate::kinds::DataModel] resource (DM-01..DM-53).",
      "properties": {
        "artifacts": {
          "allOf": [
            {
              "$ref": "#/definitions/GeneratedArtifacts"
            }
          ],
          "default": {},
          "description": "Artifacts generated beside the source in the same commit (DM-02)."
        },
        "classes": {
          "description": "NGSI-LD entity types this model defines.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "consumers": {
          "description": "Informational list of resources consuming this version (DM-25).",
          "items": {
            "$ref": "#/definitions/TypedRef"
          },
          "type": "array"
        },
        "contextSpaceRef": {
          "description": "DNS-1123 label of the owning ContextSpace; with `metadata.namespace` it derives the path (MF-06).",
          "type": "string"
        },
        "lifecycle": {
          "allOf": [
            {
              "$ref": "#/definitions/DataModelLifecycle"
            }
          ],
          "description": "Lifecycle state of this version (DM-26, DM-48)."
        },
        "linkml": {
          "description": "Path of the authoring LinkML source, relative to this manifest and ending `.linkml.yaml` (DM-01).",
          "type": "string"
        },
        "openWorld": {
          "default": false,
          "description": "Whether entities of this model may carry undeclared attributes (DM-28).",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/definitions/DataModelSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "Provenance; absent for a hand-authored model (DM-08, DM-48)."
        },
        "version": {
          "allOf": [
            {
              "$ref": "#/definitions/SemVer"
            }
          ],
          "description": "Semantic version; the major is the served `schema/v{major}` (DM-22)."
        }
      },
      "required": [
        "contextSpaceRef",
        "lifecycle",
        "linkml",
        "version"
      ],
      "type": "object"
    },
    "GeneratedArtifacts": {
      "additionalProperties": false,
      "description": "Artifacts generated beside the LinkML source and committed in the same change (DM-02).",
      "properties": {
        "context": {
          "description": "Generated JSON-LD `@context` (DM-02, DM-05).",
          "type": [
            "string",
            "null"
          ]
        },
        "docs": {
          "description": "Generated Markdown documentation (DM-02).",
          "type": [
            "string",
            "null"
          ]
        },
        "example": {
          "description": "Generated and validated example entity (DM-02, DM-21).",
          "type": [
            "string",
            "null"
          ]
        },
        "jsonSchema": {
          "description": "Generated JSON Schema draft-07 (DM-02, DM-03).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "RemoteSource": {
      "additionalProperties": false,
      "description": "Where a mirrored foreign data model came from (DM-48, DM-49).",
      "properties": {
        "fetchedAt": {
          "description": "When the fetch happened.",
          "format": "date-time",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the fetched source, 64 lowercase hexadecimal characters; a change opens a merge request.",
          "type": "string"
        },
        "url": {
          "description": "Schema surface the model was fetched from; `https://` only.",
          "type": "string"
        },
        "version": {
          "allOf": [
            {
              "$ref": "#/definitions/SemVer"
            }
          ],
          "description": "Version the peer published."
        }
      },
      "required": [
        "fetchedAt",
        "sha256",
        "url",
        "version"
      ],
      "type": "object"
    },
    "SemVer": {
      "description": "Semantic version string conforming to major.minor.patch (DM-22)",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/DataModelSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_DataModelSpec",
  "type": "object"
}
