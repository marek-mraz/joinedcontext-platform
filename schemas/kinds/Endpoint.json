{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Audience": {
      "description": "Target audience access control setting for an endpoint (EP-14).",
      "oneOf": [
        {
          "description": "Restricted to explicitly listed projects within the organization.",
          "enum": [
            "project-list"
          ],
          "type": "string"
        },
        {
          "description": "Accessible to any authenticated member or service account of the organization.",
          "enum": [
            "organization"
          ],
          "type": "string"
        },
        {
          "description": "Accessible publicly without authentication under the synthetic public role grant.",
          "enum": [
            "public"
          ],
          "type": "string"
        }
      ]
    },
    "Caching": {
      "additionalProperties": false,
      "description": "HTTP caching configuration for endpoint responses.",
      "properties": {
        "maxAgeSeconds": {
          "description": "Maximum cache age in seconds.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "maxAgeSeconds"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "EndpointSlug": {
      "description": "Cryptographically random endpoint slug with at least 128 bits of entropy (lowercase RFC 4648 base32 without padding, >=26 chars, EP-02)",
      "pattern": "^[a-z2-7]{26,}$",
      "type": "string"
    },
    "EndpointSpec": {
      "additionalProperties": false,
      "description": "Desired specification of an [`Endpoint`][crate::kinds::Endpoint] resource (EP-01..EP-28).",
      "properties": {
        "allowedProjects": {
          "description": "Whitelist of project slugs permitted when audience is `project-list` (EP-14, EP-15).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "audience": {
          "allOf": [
            {
              "$ref": "#/definitions/Audience"
            }
          ],
          "description": "Audience access scope (EP-14)."
        },
        "caching": {
          "anyOf": [
            {
              "$ref": "#/definitions/Caching"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional response caching configuration."
        },
        "contextSpaceRef": {
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ],
          "description": "Reference to the underlying ContextSpace."
        },
        "enabledRepresentations": {
          "description": "Set of enabled representation formats (EP-05).",
          "items": {
            "$ref": "#/definitions/Representation"
          },
          "type": "array"
        },
        "policyRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Urn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional NGSI-LD Policy URN attached to this endpoint."
        },
        "rateLimits": {
          "anyOf": [
            {
              "$ref": "#/definitions/RateLimits"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional rate limiting configuration (EP-20)."
        },
        "slug": {
          "allOf": [
            {
              "$ref": "#/definitions/EndpointSlug"
            }
          ],
          "description": "Unguessable opaque slug with >= 128 bits of entropy (EP-02)."
        }
      },
      "required": [
        "audience",
        "contextSpaceRef",
        "enabledRepresentations",
        "slug"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "RateLimits": {
      "additionalProperties": false,
      "description": "Token-bucket rate limiting configuration per endpoint (EP-20).",
      "properties": {
        "burst": {
          "description": "Optional maximum burst capacity above steady rate.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "requestsPerMinute": {
          "description": "Maximum allowed requests per minute.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "requestsPerMinute"
      ],
      "type": "object"
    },
    "Ref": {
      "anyOf": [
        {
          "description": "Bare string resource name.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TypedRef"
            }
          ],
          "description": "Typed reference with kind, name, and optional namespace."
        }
      ],
      "description": "Reference to another resource, either bare name or typed reference (MF-07)."
    },
    "Representation": {
      "description": "Supported representation formats served under an endpoint (EP-05, Architecture/04).\n\nNote: `schema` (EP-46) and `access` (EP-55) are not variants: they are unconditional surfaces on every endpoint and cannot be toggled off.",
      "oneOf": [
        {
          "description": "Canonical NGSI-LD representation (`/ngsi-ld/v1/`).",
          "enum": [
            "ngsi-ld"
          ],
          "type": "string"
        },
        {
          "description": "Direct Model Context Protocol streamable HTTP interface (`/mcp`).",
          "enum": [
            "mcp"
          ],
          "type": "string"
        },
        {
          "description": "GeoJSON feature collection (`/file.geojson`).",
          "enum": [
            "geojson"
          ],
          "type": "string"
        },
        {
          "description": "Flat tabular CSV (`/file.csv`).",
          "enum": [
            "csv"
          ],
          "type": "string"
        },
        {
          "description": "Flat tabular Excel spreadsheet (`/file.xlsx`).",
          "enum": [
            "xlsx"
          ],
          "type": "string"
        },
        {
          "description": "JSON array of entities (`/file.json`).",
          "enum": [
            "json"
          ],
          "type": "string"
        },
        {
          "description": "Zipped multi-representation export bundle (`/file.zip`).",
          "enum": [
            "zip"
          ],
          "type": "string"
        },
        {
          "description": "OGC API - Features Part 1 collections and items (`/ogc/features/`).",
          "enum": [
            "ogc-features"
          ],
          "type": "string"
        },
        {
          "description": "SensorThings API v1.1 read projection (`/sta/v1.1/`).",
          "enum": [
            "sta"
          ],
          "type": "string"
        }
      ]
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "Urn": {
      "description": "NGSI-LD entity URN conforming to ADR 001 / PF-42: urn:ngsi-ld:{Type}:{orgDomain}:{space}:{localId}",
      "pattern": "^urn:ngsi-ld:[A-Z][A-Za-z0-9]{1,63}:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+:[a-z0-9][a-z0-9-]{0,62}:[A-Za-z0-9._~-]{1,128}$",
      "type": "string"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/EndpointSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_EndpointSpec",
  "type": "object"
}
