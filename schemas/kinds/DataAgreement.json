{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AgreementConstraints": {
      "additionalProperties": false,
      "description": "Lossless query filter constraints mapped from an ODRL agreement (DS-10).",
      "properties": {
        "geoQ": {
          "description": "Residual geographic query filter string (DS-10).",
          "type": [
            "string",
            "null"
          ]
        },
        "q": {
          "description": "Residual NGSI-LD query filter string (DS-10).",
          "type": [
            "string",
            "null"
          ]
        },
        "scopeQ": {
          "description": "Residual scope query filter string (DS-10).",
          "type": [
            "string",
            "null"
          ]
        },
        "temporalQ": {
          "description": "Residual temporal query filter string (DS-10).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AgreementRole": {
      "description": "Role of this organization within a data space agreement (DS-07, DS-15).",
      "oneOf": [
        {
          "description": "Provider sharing data through an offered endpoint (DS-07).",
          "enum": [
            "provider"
          ],
          "type": "string"
        },
        {
          "description": "Consumer accessing data from another participant (DS-15).",
          "enum": [
            "consumer"
          ],
          "type": "string"
        }
      ]
    },
    "AgreementState": {
      "description": "Negotiation state of a Dataspace Protocol contract agreement (DS-09, DS-12).",
      "oneOf": [
        {
          "description": "Initial contract negotiation request submitted (DS-09).",
          "enum": [
            "requested"
          ],
          "type": "string"
        },
        {
          "description": "Counter-offer proposed by provider (DS-09).",
          "enum": [
            "offered"
          ],
          "type": "string"
        },
        {
          "description": "Agreement terms accepted by both parties (DS-09).",
          "enum": [
            "accepted"
          ],
          "type": "string"
        },
        {
          "description": "Agreement confirmed and active in gateway PDP (DS-09, DS-10).",
          "enum": [
            "finalized"
          ],
          "type": "string"
        },
        {
          "description": "Agreement expired or explicitly terminated (DS-12).",
          "enum": [
            "terminated"
          ],
          "type": "string"
        }
      ]
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "DataAgreementSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`DataAgreement`][crate::kinds::DataAgreement] resource (DS-09, DS-10, DS-15).",
      "properties": {
        "agreementId": {
          "description": "Unique Dataspace Protocol agreement identifier (DS-09, DS-13).",
          "type": "string"
        },
        "constraints": {
          "allOf": [
            {
              "$ref": "#/definitions/AgreementConstraints"
            }
          ],
          "default": {},
          "description": "Lossless query constraints mapped from contract agreement (DS-10)."
        },
        "offerRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference to local DataOffer for provider role (DS-07)."
        },
        "remoteParticipant": {
          "allOf": [
            {
              "$ref": "#/definitions/Did"
            }
          ],
          "description": "Decentralized identifier of the remote participant (DS-04, DS-10)."
        },
        "role": {
          "allOf": [
            {
              "$ref": "#/definitions/AgreementRole"
            }
          ],
          "description": "Operational role in this agreement (provider or consumer) (DS-07, DS-15)."
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/definitions/AgreementState"
            }
          ],
          "description": "Negotiation lifecycle state of this agreement (DS-09, DS-12)."
        },
        "tokenSecretRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/SecretRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference to transfer token in secret store for consumer role (DS-15)."
        },
        "validity": {
          "allOf": [
            {
              "$ref": "#/definitions/Validity"
            }
          ],
          "description": "Temporal validity window for this agreement (DS-10)."
        }
      },
      "required": [
        "agreementId",
        "remoteParticipant",
        "role",
        "state",
        "validity"
      ],
      "type": "object"
    },
    "Did": {
      "description": "Decentralized Identifier in the did:web method bound to an organization domain (DS-04, PF-41)",
      "pattern": "^did:web:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$",
      "type": "string"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual description (PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable multilingual title (PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "Ref": {
      "anyOf": [
        {
          "description": "Bare string resource name.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TypedRef"
            }
          ],
          "description": "Typed reference with kind, name, and optional namespace."
        }
      ],
      "description": "Reference to another resource, either bare name or typed reference (MF-07)."
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "Reference to a credential stored in SOPS or OpenBao (PF-36).\n\n`deny_unknown_fields` is a security control: it rejects inline `value:` or `password:` fields at parse time, enforcing that secrets never appear in Git or manifest files.",
      "properties": {
        "envVar": {
          "description": "Optional environment variable name for injection into runners.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "Optional key within secret.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Secret name in secret store.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "Validity": {
      "additionalProperties": false,
      "description": "Temporal validity window for a policy grant.",
      "properties": {
        "from": {
          "description": "Effective start timestamp (UTC).",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "Effective expiration timestamp (UTC).",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/DataAgreementSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_DataAgreementSpec",
  "type": "object"
}
