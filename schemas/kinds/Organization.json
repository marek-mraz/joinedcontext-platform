{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "Contact": {
      "additionalProperties": false,
      "description": "Contact information for an organization role.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "type": "string"
        },
        "name": {
          "description": "Full name of the contact person or organizational unit.",
          "type": "string"
        },
        "phone": {
          "description": "Optional contact telephone number.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "allOf": [
            {
              "$ref": "#/definitions/ContactRole"
            }
          ],
          "description": "Role of this contact."
        }
      },
      "required": [
        "email",
        "name",
        "role"
      ],
      "type": "object"
    },
    "ContactRole": {
      "description": "Functional responsibility of an organization contact.",
      "oneOf": [
        {
          "description": "Administrative contact.",
          "enum": [
            "administrative"
          ],
          "type": "string"
        },
        {
          "description": "Technical contact.",
          "enum": [
            "technical"
          ],
          "type": "string"
        },
        {
          "description": "Data protection officer / GDPR contact.",
          "enum": [
            "data-protection"
          ],
          "type": "string"
        },
        {
          "description": "Information security officer contact.",
          "enum": [
            "security"
          ],
          "type": "string"
        }
      ]
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "OrganizationSpec": {
      "additionalProperties": false,
      "description": "Desired specification of an [`Organization`][crate::kinds::Organization] resource (PF-01, PF-02, PF-25, PF-41).",
      "properties": {
        "contacts": {
          "description": "Administrative, technical, data protection, or security contacts.",
          "items": {
            "$ref": "#/definitions/Contact"
          },
          "type": "array"
        },
        "defaultLocale": {
          "description": "Organization fallback default locale, MUST be one of [`Self::locales`] (PF-25, PF-26).",
          "type": "string"
        },
        "domain": {
          "description": "Verified internet FQDN, the `{orgDomain}` of every entity URN (PF-41).",
          "type": "string"
        },
        "gitRepositoryUrl": {
          "description": "Git repository URL of the one Org Repository in Gitea (PF-02).",
          "type": [
            "string",
            "null"
          ]
        },
        "locales": {
          "description": "Ordered list of supported locales, most preferred first (PF-25).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "projects": {
          "allOf": [
            {
              "$ref": "#/definitions/ProjectsPolicy"
            }
          ],
          "default": {
            "creation": "org-admin",
            "visibility": "organization"
          },
          "description": "How projects are opened and who sees them (PF-61, PF-65)."
        }
      },
      "required": [
        "defaultLocale",
        "domain",
        "locales"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      ]
    },
    "ProjectCreation": {
      "description": "Who may open a project (PF-65). `group:<name>` names a `Group` of the organization.",
      "oneOf": [
        {
          "description": "Every signed-in person of the organization.",
          "enum": [
            "Anyone"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The members of one group.",
          "properties": {
            "Group": {
              "type": "string"
            }
          },
          "required": [
            "Group"
          ],
          "type": "object"
        },
        {
          "description": "Whoever holds `propose` on `Project`, the seeded `org-admin`.",
          "enum": [
            "OrgAdmin"
          ],
          "type": "string"
        }
      ]
    },
    "ProjectVisibility": {
      "description": "Who holds the seeded `viewer` role at organization scope (PF-61).",
      "oneOf": [
        {
          "description": "Every signed-in person of the organization reads every project.",
          "enum": [
            "organization"
          ],
          "type": "string"
        },
        {
          "description": "Only a principal a binding names reads a project.",
          "enum": [
            "members"
          ],
          "type": "string"
        }
      ]
    },
    "ProjectsPolicy": {
      "additionalProperties": false,
      "description": "The organization's rules for its projects (PF-61, PF-65).",
      "properties": {
        "creation": {
          "allOf": [
            {
              "$ref": "#/definitions/ProjectCreation"
            }
          ],
          "default": "org-admin",
          "description": "Who may open a project: `anyone`, `group:<name>` or `org-admin` (PF-65)."
        },
        "quota": {
          "anyOf": [
            {
              "$ref": "#/definitions/Quotas"
            },
            {
              "type": "null"
            }
          ],
          "description": "The quota every project the organization opens starts from (PF-73). A project may lower a value in the yellow lane; raising one above this is the red lane and an `org-admin`."
        },
        "visibility": {
          "allOf": [
            {
              "$ref": "#/definitions/ProjectVisibility"
            }
          ],
          "default": "organization",
          "description": "Who holds the seeded `viewer` role at organization scope: every signed-in person of the organization (`organization`, the default) or only whoever a binding names (`members`) (PF-61)."
        }
      },
      "type": "object"
    },
    "Quotas": {
      "additionalProperties": false,
      "description": "Structural resource quotas per project (PF-17).\n\nAn absent field indicates unlimited quota for that resource.",
      "properties": {
        "agentRunsPerDay": {
          "description": "Maximum number of agent runs the project starts in one day (PF-73, PF-74).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "apps": {
          "description": "Maximum number of Apps the project deploys (PF-73).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "contextSpaces": {
          "description": "Maximum number of active Context Spaces.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "entitiesPerSpace": {
          "description": "Maximum number of entities one Context Space of the project holds (PF-73).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ingestEventsPerSecond": {
          "description": "Maximum ingestion rate in events per second.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "publicEndpoints": {
          "description": "Maximum number of public endpoints.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "requestsPerMinute": {
          "description": "Maximum requests per minute one Endpoint of the project serves (PF-73, EP-17).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "residentPipelines": {
          "description": "Maximum number of resident streaming pipelines.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "Text": {
      "anyOf": [
        {
          "description": "The form every new manifest writes.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            }
          ],
          "description": "The legacy `{locale: text}` map."
        }
      ],
      "description": "A human label or description (UI-50): one plain string in the author's language. The legacy language map is still read, through release `v0.9`, and resolves to one string."
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version (must match [`API_VERSION`]).",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/OrganizationSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_OrganizationSpec",
  "type": "object"
}
